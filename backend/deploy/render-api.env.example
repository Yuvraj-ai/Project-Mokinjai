# Render API service — import with Environment > Add from .env, then replace every
# CHANGE_ME. These are the same keys render.yaml declares as sync: false.
# PYTHON_VERSION, JWT_SECRET_KEY and SANDBOX_BACKEND are managed by render.yaml; do
# not add them here.

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
LLM_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
FRONTEND_URL=https://CHANGE_ME.onrender.com

SANDBOX_DAEMON_URL=https://8100-CHANGE_ME.instabox.tech
SANDBOX_DAEMON_TOKEN=
SANDBOX_DAEMON_SECRET=CHANGE_ME

STORAGE_S3_BUCKET=mokinjay-uploads
STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME
STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
STORAGE_S3_REGION=us-west-004

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
