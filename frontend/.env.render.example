# Render static site — import with Environment > Add from .env, then replace every
# CHANGE_ME. All values are baked in at build time; redeploy after changing one.
# NODE_VERSION is managed by render.yaml; do not add it here.

VITE_API_URL=https://CHANGE_ME.onrender.com

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=
