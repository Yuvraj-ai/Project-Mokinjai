# API URL (leave empty in dev to use Vite proxy)
VITE_API_URL=

# Google Picker — all three are public by design and baked in at build time.
# The API key must be referrer-restricted to the app origins and https://docs.google.com/*.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PROJECT_NUMBER=
