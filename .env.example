# Mokinjay environment template.
#
# Copy this to .env, then fill in the values:
#     cp .env.example .env
#
# .env is gitignored. Never commit it, and never paste real secrets in here.

# --- Database (PostgreSQL only — see ADR-022) ---
# Local development and tests. The test database name MUST end in "_test":
# the suite truncates every table and refuses any other name.
DATABASE_URL=postgresql+asyncpg://imyuvi@localhost:5432/mokinjay
TEST_DATABASE_URL=postgresql+asyncpg://imyuvi@localhost:5432/mokinjay_test

# Hosted (Supabase) example shape — use the **session pooler** string and keep
# the `postgresql+asyncpg://` prefix:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler breaks asyncpg's prepared statements; the direct
# connection host (db.<ref>.supabase.co) is IPv6-only without a paid add-on.

# --- Secrets ---
# Access/refresh token signing key. Generate with:
#     backend/venv/bin/python scripts/generate_jwt_secret.py
# Rotating this is cheap: outstanding tokens stop validating, and users sign in
# again. Nothing is lost.
JWT_SECRET_KEY=

# Encrypts stored LLM API keys at rest (Fernet). Generate with:
#     backend/venv/bin/python scripts/generate_fernet_key.py
# WARNING: rotating this is DESTRUCTIVE — every stored LLM API key becomes
# undecryptable and must be re-entered by hand. Required: without it, saving an
# LLM profile with an API key raises at runtime.
LLM_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379

# --- Admin OTP login (delivered via Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
OTP_EXPIRY_SECONDS=300

# --- App ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:5173

# --- External databases ---
# NOT read by the application yet: Settings sets extra="ignore", so these are
# silently dropped. Reserved for the knowledge-base external-connection feature.
MONGO_URL=
MONGO_DB_NAME=

# --- Migrations ---
# Alembic refuses to run against a non-local DATABASE_URL unless this is set,
# because migrations execute DDL. Required only to migrate the hosted instance:
# ALLOW_REMOTE_MIGRATIONS=1
